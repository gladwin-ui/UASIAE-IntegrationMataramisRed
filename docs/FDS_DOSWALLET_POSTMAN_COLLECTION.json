                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetMyTransactions($limit: Int, $offset: Int) {\\n  myTransactions(limit: $limit, offset: $offset) {\\n    transaction_id\\n    user_id\\n    amount\\n    type\\n    description\\n    status\\n    date\\n  }\\n}",
                                "variables": "{\\n  \\\"limit\\\": 10,\\n  \\\"offset\\\": 0\\n}"
                            }
                        },
                        "url": {
                            "raw": "http://localhost:5003/graphql",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "5003",
                            "path": [
                                "graphql"
                            ]
                        }
                    }
                },
                {
