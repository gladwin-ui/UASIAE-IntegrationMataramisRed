                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation PayOrder($orderId: Int!, $method: String!) {\\n  payOrder(orderId: $orderId, method: $method) {\\n    success\\n    message\\n    payment {\\n      id\\n      amount\\n      status\\n      method\\n    }\\n  }\\n}",
                                "variables": "{\\n  \\\"orderId\\\": 1,\\n  \\\"method\\\": \\\"DOSWALLET\\\"\\n}"
                            }
                        },
                        "url": {
                            "raw": "http://localhost:4004/graphql",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "4004",
                            "path": [
                                "graphql"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "DosWallet - Transactions",
            "item": [
                {
                    "name": "Get My Transactions",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
