                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetMyOrders {\\n  myOrders {\\n    id\\n    restaurantId\\n    totalPrice\\n    status\\n    deliveryAddress\\n    createdAt\\n  }\\n}"
                            }
                        },
                        "url": {
                            "raw": "http://localhost:4003/graphql",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "4003",
                            "path": [
                                "graphql"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "FDS - Payment",
            "item": [
                {
                    "name": "Pay Order (DosWallet)",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
