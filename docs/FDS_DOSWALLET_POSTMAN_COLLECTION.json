{
    "info": {
        "name": "FDS & DosWallet GraphQL API Collection",
        "description": "Complete API collection for Food Delivery System and DosWallet GraphQL integration testing",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "auth": {
        "type": "bearer",
        "bearer": [
            {
                "key": "token",
                "value": "{{auth_token}}",
                "type": "string"
            }
        ]
    },
    "item": [
        {
            "name": "FDS - Authentication",
            "item": [
                {
                    "name": "Login",
                    "event": [
                        {
                            "listen": "test",
                            "script": {
                                "exec": [
                                    "const response = pm.response.json();",
                                    "if (response.data && response.data.login && response.data.login.token) {",
                                    "    pm.collectionVariables.set('auth_token', response.data.login.token);",
                                    "    console.log('Token saved:', response.data.login.token);",
                                    "}"
                                ],
                                "type": "text/javascript"
                            }
                        }
                    ],
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation Login($email: String!, $password: String!) {\\n  login(email: $email, password: $password) {\\n    token\\n    user {\\n      id\\n      email\\n      role\\n    }\\n  }\\n}",
                                "variables": "{\\n  \\\"email\\\": \\\"customer1@example.com\\\",\\n  \\\"password\\\": \\\"password\\\"\\n}"
                            }
                        },
                        "url": {
                            "raw": "http://localhost:4001/graphql",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "4001",
                            "path": [
                                "graphql"
                            ]
                        }
                    }
                },
                {
                    "name": "Register",
                    "request": {
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation Register($email: String!, $password: String!, $name: String!, $role: String!) {\\n  register(email: $email, password: $password, name: $name, role: $role) {\\n    success\\n    message\\n    userId\\n  }\\n}",
                                "variables": "{\\n  \\\"email\\\": \\\"newuser@example.com\\\",\\n  \\\"password\\\": \\\"password123\\\",\\n  \\\"name\\\": \\\"New User\\\",\\n  \\\"role\\\": \\\"CUSTOMER\\\"\\n}"
                            }
                        },
                        "url": {
                            "raw": "http://localhost:4001/graphql",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "4001",
                            "path": [
                                "graphql"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "FDS - Restaurants",
            "item": [
                {
                    "name": "Get All Restaurants",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetRestaurants {\\n  restaurants {\\n    id\\n    name\\n    address\\n    isOpen\\n    category\\n    imageUrl\\n  }\\n}"
                            }
                        },
                        "url": {
                            "raw": "http://localhost:4002/graphql",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "4002",
                            "path": [
                                "graphql"
                            ]
                        }
                    }
                },
                {
                    "name": "Get Restaurant Menus",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "query GetRestaurantMenus($restaurantId: Int!) {\\n  menus(restaurantId: $restaurantId) {\\n    id\\n    name\\n    price\\n    description\\n    available\\n  }\\n}",
                                "variables": "{\\n  \\\"restaurantId\\\": 1\\n}"
                            }
                        },
                        "url": {
                            "raw": "http://localhost:4002/graphql",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "4002",
                            "path": [
                                "graphql"
                            ]
                        }
                    }
                }
            ]
        },
        {
            "name": "FDS - Orders",
            "item": [
                {
                    "name": "Create Order",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
                            {
                                "key": "Content-Type",
                                "value": "application/json"
                            }
                        ],
                        "body": {
                            "mode": "graphql",
                            "graphql": {
                                "query": "mutation CreateOrder($restaurantId: Int!, $items: [OrderItemInput!]!, $deliveryAddress: String!) {\\n  createOrder(restaurantId: $restaurantId, items: $items, deliveryAddress: $deliveryAddress) {\\n    success\\n    message\\n    order {\\n      id\\n      totalPrice\\n      status\\n    }\\n  }\\n}",
                                "variables": "{\\n  \\\"restaurantId\\\": 1,\\n  \\\"items\\\": [\\n    {\\n      \\\"menuId\\\": 1,\\n      \\\"quantity\\\": 2,\\n      \\\"price\\\": 25000\\n    }\\n  ],\\n  \\\"deliveryAddress\\\": \\\"Jl. Sudirman No. 123, Jakarta\\\"\\n}"
                            }
                        },
                        "url": {
                            "raw": "http://localhost:4003/graphql",
                            "protocol": "http",
                            "host": [
                                "localhost"
                            ],
                            "port": "4003",
                            "path": [
                                "graphql"
                            ]
                        }
                    }
                },
                {
                    "name": "Get My Orders",
                    "request": {
                        "auth": {
                            "type": "bearer",
                            "bearer": [
                                {
                                    "key": "token",
                                    "value": "{{auth_token}}",
                                    "type": "string"
                                }
                            ]
                        },
                        "method": "POST",
                        "header": [
