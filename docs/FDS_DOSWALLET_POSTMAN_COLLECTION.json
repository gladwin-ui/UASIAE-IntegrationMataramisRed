                                "query": "query GetTransactionsByType($type: String!, $limit: Int, $offset: Int) {\\n  transactionsByType(type: $type, limit: $limit, offset: $offset) {\\n    transaction_id\\n    user_id\\n    amount\\n    type\\n    description\\n    status\\n    date\\n  }\\n}",
                                "variables": "{\\n  \\\"type\\\": \\\"withdraw\\\",\\n  \\\"limit\\\": 10,\\n  \\\"offset\\\": 0\\n}"
